{
  "manifest_version": 3,
  "name": "webext-utils example",
  "version": "0.0.1",
  "permissions": ["storage"],
  "action": {
    "default_popup": "ui.html"
  },
  "host_permissions": ["https://example.com/*"],
  "content_scripts": [
    {
      "matches": ["https://example.com/*"],
      "js": ["isolated.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": ["https://example.com/*"],
      "js": ["main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "webext-utils-example@example.com",
      "strict_min_version": "145.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "sidebar_action": {
    "default_panel": "ui.html",
    "default_title": "Example",
    "open_at_install": false
  }
}
